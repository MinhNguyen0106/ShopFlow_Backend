# Application Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://shopflow_user:shopflow_secret_2026@localhost:5432/shopflow_db

# Redis & Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (JWT Secrets)
JWT_ACCESS_SECRET=shopflow_dev_jwt_access_secret_key_32chars_min!
JWT_REFRESH_SECRET=shopflow_dev_jwt_refresh_secret_key_32chars_min!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Meta Graph API & Webhook Configuration (Configured in Task-07)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=shopflow_webhook_verify_token_dev

# AES-256-GCM Token Encryption Key
TOKEN_ENCRYPTION_KEY=shopflow_dev_aes256_encryption_key_32bytes_secret!
