# ==============================================================================
# ShopFlow - Cấu hình Biến Môi Trường Docker (Local Development)
# ==============================================================================
#
# HƯỚNG DẪN SỬ DỤNG:
#   1. Sao chép tệp này thành `.env.docker`:
#      cp .env.docker.example .env.docker      (Linux/macOS)
#      copy .env.docker.example .env.docker    (Windows CMD)
#
#   2. Thay đổi các giá trị mặc định nếu cần (đặc biệt là mật khẩu).
#
#   3. Khởi động Docker services:
#      docker-compose --env-file .env.docker up -d
#
# CẢNH BÁO BẢO MẬT:
#   - KHÔNG commit tệp `.env.docker` lên git (đã thêm vào .gitignore).
#   - CHỈ sử dụng các giá trị này cho môi trường phát triển CỤC BỘ.
#   - Thay đổi toàn bộ mật khẩu trước khi triển khai lên môi trường staging/production.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL 15 Configuration
# ------------------------------------------------------------------------------
# Tên cơ sở dữ liệu
POSTGRES_DB=shopflow_db

# Tên đăng nhập PostgreSQL
POSTGRES_USER=shopflow_user

# Mật khẩu PostgreSQL (THAY ĐỔI trước khi dùng ở môi trường khác)
POSTGRES_PASSWORD=shopflow_secret_2024

# Cổng kết nối PostgreSQL trên máy host (mặc định: 5432)
# Đổi sang cổng khác nếu 5432 đã bị chiếm dụng
POSTGRES_PORT=5432

# Connection string đầy đủ (dùng trong backend .env)
# DATABASE_URL=postgresql://shopflow_user:shopflow_secret_2024@localhost:5432/shopflow_db

# ------------------------------------------------------------------------------
# Redis 7 Configuration
# ------------------------------------------------------------------------------
# Mật khẩu Redis (THAY ĐỔI trước khi dùng ở môi trường khác)
REDIS_PASSWORD=redis_secret_2024

# Cổng kết nối Redis trên máy host (mặc định: 6379)
# Đổi sang cổng khác nếu 6379 đã bị chiếm dụng
REDIS_PORT=6379

# Connection string đầy đủ (dùng trong backend .env)
# REDIS_URL=redis://:redis_secret_2024@localhost:6379

# ------------------------------------------------------------------------------
# Ghi chú
# ------------------------------------------------------------------------------
# Sau khi khởi động container, kiểm tra kết nối bằng:
#   PowerShell: .\scripts\test-services.ps1
